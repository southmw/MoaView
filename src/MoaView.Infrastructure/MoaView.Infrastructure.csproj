<Project Sdk="Microsoft.NET.Sdk">

  <!-- SQLite 영속화, DPAPI 암호화, WebView2 환경, 서비스별 Provider 구현(04 아키텍처 3절). -->
  <PropertyGroup>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>$(WindowsMinimumVersion)</SupportedOSPlatformVersion>
    <!-- WebView2 패키지가 WPF 어셈블리를 함께 참조하므로 WindowsBase 버전 충돌(MSB3277)을 막기 위해 켠다 -->
    <UseWPF>true</UseWPF>
    <RootNamespace>MoaView.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoaView.Core\MoaView.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!-- System.Security.Cryptography.ProtectedData는 Windows TFM의 공유 프레임워크에 포함되어 패키지 참조가 필요 없다 -->
  </ItemGroup>

</Project>
