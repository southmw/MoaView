<ui:FluentWindow x:Class="MoaView.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MoaView.App.Resources"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MoaView.App.ViewModels"
        xmlns:conv="clr-namespace:MoaView.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="{x:Static res:Strings.Settings}"
        Width="920" Height="600"
        MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <conv:IndexToVisibilityConverter x:Key="TabVisible" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="TabPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="24,12,24,24" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.Settings}" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 왼쪽 탭 목록(06 UI/UX 3절) -->
            <ListBox Grid.Column="0" Margin="12,8,0,12" ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTabIndex}"
                     BorderThickness="0" Background="Transparent" AutomationProperties.Name="{x:Static res:Strings.SettingsTabs}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="14" Margin="8,6" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- 0. 일반 -->
                    <StackPanel Style="{StaticResource TabPanel}" Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabVisible}, ConverterParameter=0}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.General}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.StartupService}" />
                        <RadioButton Content="{x:Static res:Strings.StartWithLast}" IsChecked="{Binding StartWithLast}" GroupName="Startup" />
                        <DockPanel Margin="0,4,0,0">
                            <RadioButton DockPanel.Dock="Left" Content="{x:Static res:Strings.StartWithFixed}" IsChecked="{Binding StartWithFixed}" GroupName="Startup" VerticalAlignment="Center" />
                            <ComboBox Margin="8,0,0,0" Width="220" HorizontalAlignment="Left"
                                      ItemsSource="{Binding StartupCandidates}" SelectedItem="{Binding StartupService}"
                                      IsEnabled="{Binding StartWithFixed}" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Theme}" />
                        <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" AutomationProperties.Name="{x:Static res:Strings.Theme}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.ThemeHint}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.WindowSection}" />
                        <!-- 트레이 상주(FR-NAV-05)는 Could이고 개발 계획에 없어 항목을 두지 않는다. 중복 실행 방지는 항상 켜져 있어 옵션이 없다. -->
                        <TextBlock Style="{StaticResource Hint}" Margin="0" Text="{x:Static res:Strings.SingleInstanceHint}" />
                    </StackPanel>

                    <!-- 1. 서비스 -->
                    <StackPanel Style="{StaticResource TabPanel}" Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabVisible}, ConverterParameter=1}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.ServiceManagement}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:ListView Grid.Column="0" MinHeight="240" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}"
                                         SelectionMode="Single" AutomationProperties.Name="{x:Static res:Strings.ServiceList}">
                                <ui:ListView.View>
                                    <ui:GridView>
                                        <ui:GridViewColumn Header="#" Width="34" DisplayMemberBinding="{Binding Order}" />
                                        <ui:GridViewColumn Header="{x:Static res:Strings.Name}" Width="100" DisplayMemberBinding="{Binding Name}" />
                                        <ui:GridViewColumn Header="{x:Static res:Strings.Address}" Width="140" DisplayMemberBinding="{Binding Host}" />
                                        <ui:GridViewColumn Header="{x:Static res:Strings.Show}" Width="56">
                                            <ui:GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" ToolTip="{x:Static res:Strings.ShowInSidebar}" />
                                                </DataTemplate>
                                            </ui:GridViewColumn.CellTemplate>
                                        </ui:GridViewColumn>
                                        <ui:GridViewColumn Header="{x:Static res:Strings.PauseOnSwitch}" Width="118">
                                            <ui:GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding PauseOnSwitch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </ui:GridViewColumn.CellTemplate>
                                        </ui:GridViewColumn>
                                        <ui:GridViewColumn Header="{x:Static res:Strings.Zoom}" Width="54" DisplayMemberBinding="{Binding ZoomText}" />
                                        <ui:GridViewColumn Header="{x:Static res:Strings.Kind}" Width="54" DisplayMemberBinding="{Binding KindText}" />
                                    </ui:GridView>
                                </ui:ListView.View>
                            </ui:ListView>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Width="110">
                                <StackPanel.Resources>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </StackPanel.Resources>
                                <ui:Button Content="{x:Static res:Strings.AddEllipsis}" Command="{Binding AddServiceCommand}" Appearance="Primary" />
                                <ui:Button Content="{x:Static res:Strings.EditEllipsis}" Command="{Binding EditServiceCommand}" />
                                <ui:Button Content="{x:Static res:Strings.Delete}" Command="{Binding DeleteServiceCommand}" Appearance="Danger" />
                                <Separator Margin="0,4,0,12" />
                                <ui:Button Content="{x:Static res:Strings.MoveUp}" Command="{Binding MoveUpCommand}" Icon="{ui:SymbolIcon ArrowUp24}" />
                                <ui:Button Content="{x:Static res:Strings.MoveDown}" Command="{Binding MoveDownCommand}" Icon="{ui:SymbolIcon ArrowDown24}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ServiceStatus}" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{x:Static res:Strings.ServicesHint}" />
                    </StackPanel>

                    <!-- 2. 계정 -->
                    <StackPanel Style="{StaticResource TabPanel}" Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabVisible}, ConverterParameter=2}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.Account}" />
                        <ItemsControl ItemsSource="{Binding AccountSummaries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AccountSummaryViewModel}">
                                    <Border Padding="12,8" Margin="0,0,0,6" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                        <DockPanel>
                                            <ui:Button DockPanel.Dock="Right" Content="{x:Static res:Strings.ManageEllipsis}" VerticalAlignment="Center"
                                                       Command="{Binding DataContext.ManageAccountsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.75" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{x:Static res:Strings.AccountsTabHint}" />
                    </StackPanel>

                    <!-- 3. 재생 -->
                    <StackPanel Style="{StaticResource TabPanel}" Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabVisible}, ConverterParameter=3}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.PlaybackResources}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.SuspendAfterLabel}" />
                        <ui:NumberBox Width="200" HorizontalAlignment="Left" Minimum="0" Maximum="86400" SmallChange="30" LargeChange="300" MaxDecimalPlaces="0"
                                      SpinButtonPlacementMode="Inline" Value="{Binding SuspendAfterSeconds, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.SuspendHint}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.MaxAliveLabel}" />
                        <ui:NumberBox Width="200" HorizontalAlignment="Left" Minimum="1" Maximum="10" SmallChange="1" MaxDecimalPlaces="0"
                                      SpinButtonPlacementMode="Inline" Value="{Binding MaxAliveHosts, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.MaxAliveHint}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.MiniPlayer}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0" Text="{x:Static res:Strings.MiniPlayerHint}" />
                    </StackPanel>

                    <!-- 4. 단축키 -->
                    <StackPanel Style="{StaticResource TabPanel}" Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabVisible}, ConverterParameter=4}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.Shortcuts}" />
                        <ItemsControl ItemsSource="{Binding Shortcuts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ShortcutRow}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Keys}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{Binding Action}" FontSize="13" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.ShortcutsHint}" />
                    </StackPanel>

                    <!-- 5. 데이터 -->
                    <StackPanel Style="{StaticResource TabPanel}" Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabVisible}, ConverterParameter=5}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.Data}" />
                        <TextBlock Text="{Binding DataFolder}" FontSize="12" Opacity="0.8" />
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.DataFolderHint}" />

                        <WrapPanel Margin="0,12,0,0">
                            <ui:Button Content="{x:Static res:Strings.OpenDataFolder}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8" />
                            <ui:Button Content="{x:Static res:Strings.OpenLogsFolder}" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,8" />
                            <ui:Button Content="{x:Static res:Strings.BackupDbEllipsis}" Command="{Binding BackupDatabaseCommand}" Margin="0,0,8,8" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Reset}" />
                        <ui:Button Content="{x:Static res:Strings.ResetAllServiceData}" Command="{Binding ResetWebViewDataCommand}" Appearance="Danger" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.ResetHint}" />

                        <TextBlock Text="{Binding DataStatus}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 6. 정보 -->
                    <StackPanel Style="{StaticResource TabPanel}" Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabVisible}, ConverterParameter=6}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.About}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="FontSize" Value="13" />
                                </Style>
                            </Grid.Resources>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="MoaView" Opacity="0.7" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.WebView2Runtime}" Opacity="0.7" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RuntimeVersion}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text=".NET" Opacity="0.7" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DotNetVersion}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:Strings.LogsFolder}" Opacity="0.7" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LogsFolder}" TextWrapping="Wrap" />
                        </Grid>
                        <WrapPanel Margin="0,4,0,0">
                            <ui:Button Content="{x:Static res:Strings.OpenLogsFolder}" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,8" />
                            <ui:Button Content="{x:Static res:Strings.GitHubRepository}" Command="{Binding OpenRepositoryCommand}" Margin="0,0,8,8" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Update}" />
                        <WrapPanel>
                            <ui:Button Content="{x:Static res:Strings.CheckUpdates}" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding CanCheckUpdates}" Margin="0,0,8,8" />
                            <ui:Button Content="{x:Static res:Strings.RestartToApply}" Command="{Binding ApplyUpdateCommand}" Appearance="Primary" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Text="{Binding UpdateStatus}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0"
                                   Text="{x:Static res:Strings.AboutDescription}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
