<ui:FluentWindow x:Class="MoaView.App.Views.AccountEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="계정"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="계정" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,10,0,4" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Opacity" Value="0.85" />
                </Style>
            </StackPanel.Resources>

            <TextBlock Text="표시 이름" />
            <ui:TextBox x:Name="DisplayNameBox" PlaceholderText="예: 내 계정" />

            <TextBlock Text="로그인 방식" />
            <ComboBox x:Name="ProviderBox" HorizontalAlignment="Stretch" />

            <TextBlock Text="아이디 / 이메일" />
            <ui:TextBox x:Name="LoginIdBox" />

            <TextBlock x:Name="PasswordLabel" Text="비밀번호" />
            <ui:PasswordBox x:Name="PasswordBox" PlaceholderText="" RevealButtonEnabled="False" />

            <CheckBox x:Name="IsDefaultBox" Content="기본 계정으로 사용" Margin="0,12,0,0" />
            <CheckBox x:Name="AutoFillBox" Content="로그인이 끊기면 자동 입력" Margin="0,4,0,0" />
            <CheckBox x:Name="AutoSubmitBox" Content="자동 제출 (로그인 버튼까지 자동 클릭)" Margin="0,4,0,0" />
            <TextBlock Text="연속 2회 실패하면 자동 제출이 꺼집니다. 캡차·2단계 인증이 있는 서비스에서는 끄는 것이 좋습니다."
                       Margin="24,2,0,0" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />

            <TextBlock x:Name="ErrorText" Foreground="#FF8A80" Margin="0,8,0,0" Visibility="Collapsed" />

            <Border Margin="0,12,0,0" Padding="10,8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <TextBlock Text="비밀번호는 Windows 계정으로 암호화되어 이 PC에만 저장됩니다. 다른 PC나 계정으로 옮기면 복원되지 않습니다."
                           FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="취소" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="80" />
                <ui:Button Content="저장" Click="OnSaveClick" Appearance="Primary" MinWidth="80" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
