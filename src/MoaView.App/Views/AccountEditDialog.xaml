<ui:FluentWindow x:Class="MoaView.App.Views.AccountEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MoaView.App.Resources"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{x:Static res:Strings.Account}"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="{x:Static res:Strings.Account}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,10,0,4" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Opacity" Value="0.85" />
                </Style>
            </StackPanel.Resources>

            <TextBlock Text="{x:Static res:Strings.DisplayName}" />
            <ui:TextBox x:Name="DisplayNameBox" PlaceholderText="{x:Static res:Strings.DisplayNamePlaceholder}" />

            <TextBlock Text="{x:Static res:Strings.LoginMethod}" />
            <ComboBox x:Name="ProviderBox" HorizontalAlignment="Stretch" />

            <TextBlock Text="{x:Static res:Strings.LoginIdOrEmail}" />
            <ui:TextBox x:Name="LoginIdBox" />

            <TextBlock x:Name="PasswordLabel" Text="{x:Static res:Strings.Password}" />
            <ui:PasswordBox x:Name="PasswordBox" PlaceholderText="" RevealButtonEnabled="False" />

            <CheckBox x:Name="IsDefaultBox" Content="{x:Static res:Strings.UseAsDefaultAccount}" Margin="0,12,0,0" />
            <CheckBox x:Name="AutoFillBox" Content="{x:Static res:Strings.AutoFillWhenLoggedOut}" Margin="0,4,0,0" />
            <CheckBox x:Name="AutoSubmitBox" Content="{x:Static res:Strings.AutoSubmitOption}" Margin="0,4,0,0" />
            <TextBlock Text="{x:Static res:Strings.AutoSubmitHint}"
                       Margin="24,2,0,0" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />

            <TextBlock x:Name="ErrorText" Foreground="#FF8A80" Margin="0,8,0,0" Visibility="Collapsed" />

            <Border Margin="0,12,0,0" Padding="10,8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <TextBlock Text="{x:Static res:Strings.PasswordDpapiNote}"
                           FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="{x:Static res:Strings.Cancel}" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="80" />
                <ui:Button Content="{x:Static res:Strings.Save}" Click="OnSaveClick" Appearance="Primary" MinWidth="80" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
