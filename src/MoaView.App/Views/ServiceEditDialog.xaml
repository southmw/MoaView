<ui:FluentWindow x:Class="MoaView.App.Views.ServiceEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MoaView.App.Resources"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{x:Static res:Strings.Service}"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="{x:Static res:Strings.Service}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,10,0,4" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Opacity" Value="0.85" />
                </Style>
            </StackPanel.Resources>

            <TextBlock Text="{x:Static res:Strings.Name}" />
            <ui:TextBox x:Name="NameBox" PlaceholderText="{x:Static res:Strings.ServiceNamePlaceholder}" />

            <TextBlock Text="{x:Static res:Strings.HomeUrl}" />
            <ui:TextBox x:Name="HomeUrlBox" PlaceholderText="https://..." />

            <TextBlock Text="{x:Static res:Strings.AccentColorLabel}" />
            <DockPanel>
                <Border x:Name="ColorPreview" DockPanel.Dock="Right" Width="28" Height="28" Margin="8,0,0,0" CornerRadius="14" />
                <ui:TextBox x:Name="ColorBox" PlaceholderText="#3B82F6" TextChanged="OnColorChanged" />
            </DockPanel>

            <Expander x:Name="AdvancedExpander" Header="{x:Static res:Strings.AdvancedHeader}" Margin="0,12,0,0">
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="{x:Static res:Strings.LoginUrlLabel}" />
                    <ui:TextBox x:Name="LoginUrlBox" PlaceholderText="https://.../login" />

                    <TextBlock Text="{x:Static res:Strings.LoginUrlPatternLabel}" />
                    <ui:TextBox x:Name="LoginPatternBox" PlaceholderText="^https://www\.example\.com/login" />

                    <TextBlock Text="{x:Static res:Strings.AllowedHostsLabel}" />
                    <ui:TextBox x:Name="HostsBox" AcceptsReturn="True" MinHeight="72" MaxHeight="140"
                                VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                    <TextBlock x:Name="DefaultsHint" Margin="0,4,0,0" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <TextBlock x:Name="ErrorText" Foreground="#FF8A80" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

            <Border Margin="0,12,0,0" Padding="10,8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <TextBlock x:Name="NoteText" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0"
                           Text="{x:Static res:Strings.ServiceEditNote}" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="{x:Static res:Strings.Cancel}" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="80" />
                <ui:Button Content="{x:Static res:Strings.Save}" Click="OnSaveClick" Appearance="Primary" MinWidth="80" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
