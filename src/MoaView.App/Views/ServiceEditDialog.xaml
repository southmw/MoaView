<ui:FluentWindow x:Class="MoaView.App.Views.ServiceEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="서비스"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="서비스" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,10,0,4" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Opacity" Value="0.85" />
                </Style>
            </StackPanel.Resources>

            <TextBlock Text="이름" />
            <ui:TextBox x:Name="NameBox" PlaceholderText="예: Disney+" />

            <TextBlock Text="홈 URL" />
            <ui:TextBox x:Name="HomeUrlBox" PlaceholderText="https://..." />

            <TextBlock Text="강조 색 (#RRGGBB, 사이드바 아이콘 색)" />
            <DockPanel>
                <Border x:Name="ColorPreview" DockPanel.Dock="Right" Width="28" Height="28" Margin="8,0,0,0" CornerRadius="14" />
                <ui:TextBox x:Name="ColorBox" PlaceholderText="#3B82F6" TextChanged="OnColorChanged" />
            </DockPanel>

            <Expander x:Name="AdvancedExpander" Header="고급 (로그인 감지·허용 호스트)" Margin="0,12,0,0">
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="로그인 페이지 URL (비워 두면 기본값)" />
                    <ui:TextBox x:Name="LoginUrlBox" PlaceholderText="https://.../login" />

                    <TextBlock Text="로그인 페이지 URL 정규식 (비워 두면 기본값)" />
                    <ui:TextBox x:Name="LoginPatternBox" PlaceholderText="^https://www\.example\.com/login" />

                    <TextBlock Text="앱 안에서 열 호스트 (줄마다 하나, *.example.com 형식. 비워 두면 기본값)" />
                    <ui:TextBox x:Name="HostsBox" AcceptsReturn="True" MinHeight="72" MaxHeight="140"
                                VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                    <TextBlock x:Name="DefaultsHint" Margin="0,4,0,0" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <TextBlock x:Name="ErrorText" Foreground="#FF8A80" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

            <Border Margin="0,12,0,0" Padding="10,8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <TextBlock x:Name="NoteText" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0"
                           Text="서비스의 공식 웹 플레이어를 앱 안에서 엽니다. 재생이 되는지는 서비스가 WebView2(Edge)를 허용하는지에 달려 있습니다." />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="취소" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="80" />
                <ui:Button Content="저장" Click="OnSaveClick" Appearance="Primary" MinWidth="80" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
