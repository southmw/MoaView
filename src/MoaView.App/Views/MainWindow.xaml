<ui:FluentWindow x:Class="MoaView.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MoaView.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/moaview.ico"
        Width="1600" Height="900"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        PreviewKeyDown="OnPreviewKeyDown">

    <ui:FluentWindow.Resources>
        <!--
            사이드바 항목 공통 레이아웃: [강조 막대 4] [아이콘 48] [이름 *].
            접힌 폭(64px)에서는 이름 열이 잘려 아이콘만 보이고, 펼치면(200px) 이름과 단축키가 보인다.
        -->
        <Style x:Key="SidebarItemButton" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6" ClipToBounds="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,8,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SidebarHint" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- 서비스 항목: 이니셜 원형 아이콘(브랜드 로고 미포함, D-08), 선택은 왼쪽 강조 막대, 로드됨은 점. -->
        <DataTemplate x:Key="ServiceItemTemplate" DataType="{x:Type vm:ServiceItemViewModel}">
            <Button Style="{StaticResource SidebarItemButton}"
                    Command="{Binding DataContext.SelectServiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Name}"
                    AutomationProperties.Name="{Binding Name}">
                <!-- 우클릭 메뉴(06 UI/UX 2.1절). ContextMenu는 PlacementTarget의 DataContext(항목)를 물려받는다. -->
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="계정 관리..." Command="{Binding Owner.ManageAccountsCommand}" CommandParameter="{Binding}" />
                        <MenuItem Header="서비스 편집..." Command="{Binding Owner.EditServiceCommand}" CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="홈으로" Command="{Binding Owner.GoHomeOfCommand}" CommandParameter="{Binding}" />
                        <MenuItem Header="새로고침" Command="{Binding Owner.ReloadOfCommand}" CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="로그아웃 (쿠키 삭제)" Command="{Binding Owner.LogoutCommand}" CommandParameter="{Binding}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="Marker" Grid.Column="0" Width="3" Margin="0,12" CornerRadius="2"
                            Background="{Binding AccentBrush}" Visibility="Hidden" />

                    <Grid Grid.Column="1" Width="48" Height="52">
                        <!-- 캐시된 파비콘이 있으면 그것을, 없으면 이니셜 원(FR-SVC-06, D-08) -->
                        <Ellipse x:Name="InitialCircle" Width="36" Height="36" Fill="{Binding AccentBrush}" Opacity="0.9" />
                        <TextBlock x:Name="InitialText" Text="{Binding Initial}" FontSize="16" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border x:Name="IconBorder" Width="36" Height="36" CornerRadius="8" ClipToBounds="True" Visibility="Collapsed"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <Image Source="{Binding IconSource}" Width="28" Height="28" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <Ellipse x:Name="LoadedDot" Width="8" Height="8" Fill="#9CDCFE" Visibility="Collapsed"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,6" />
                    </Grid>

                    <TextBlock Grid.Column="2" Style="{StaticResource SidebarLabel}" Text="{Binding Name}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource SidebarHint}" Text="{Binding HotkeyText}" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                    <Setter TargetName="LoadedDot" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconSource, Converter={StaticResource IsNotNull}}" Value="True">
                    <Setter TargetName="IconBorder" Property="Visibility" Value="Visible" />
                    <Setter TargetName="InitialCircle" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="InitialText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 커스텀 타이틀바(06 UI/UX 2.1절). 전체화면·미니면 숨긴다. -->
        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}"
                     Visibility="{Binding IsChromeVisible, Converter={StaticResource BoolToVisibility}}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/moaview.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 미니 플레이어 바(06 UI/UX 2.3절): 드래그로 이동, 더블클릭으로 복귀, Esc/Ctrl+M으로도 복귀 -->
        <Border Grid.Row="1" Height="10" Background="{DynamicResource SystemAccentColorPrimaryBrush}" Cursor="SizeAll"
                ToolTip="드래그: 이동 / 더블클릭 또는 Esc: 원래 크기로"
                Visibility="{Binding IsMini, Converter={StaticResource BoolToVisibility}}"
                MouseLeftButtonDown="OnMiniBarMouseDown" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 사이드바: 64px, 펼치면 200px. 상단 도구막대와 탐색 버튼은 없다(D-10). -->
            <Border Grid.Column="0" Padding="4,4,4,8"
                    Visibility="{Binding IsChromeVisible, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="64" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                <Setter Property="Width" Value="200" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <DockPanel>
                    <!-- 펼치기/접기 -->
                    <Button DockPanel.Dock="Top" Style="{StaticResource SidebarItemButton}" Height="44"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="사이드바 펼치기/접기 (Ctrl+B)" AutomationProperties.Name="사이드바 펼치기/접기">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="1" Symbol="Navigation24" FontSize="20"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource SidebarHint}" FontSize="12" Text="Ctrl+B" />
                        </Grid>
                    </Button>

                    <!-- 하단: 미니 플레이어, 전체화면, 서비스 추가, 설정. 서비스 항목과 같은 열 구성이라 펼치면 이름이 함께 보인다. -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Separator Margin="8,4" />

                        <Button Style="{StaticResource SidebarItemButton}" Height="44"
                                Command="{Binding ToggleMiniCommand}"
                                ToolTip="미니 플레이어 (Ctrl+M)" AutomationProperties.Name="미니 플레이어">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="1" Symbol="PictureInPicture24" FontSize="20"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource SidebarLabel}" Text="미니 플레이어" />
                                <TextBlock Grid.Column="3" Style="{StaticResource SidebarHint}" Text="Ctrl+M" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SidebarItemButton}" Height="44"
                                Command="{Binding ToggleFullScreenCommand}"
                                ToolTip="전체화면 (F11)" AutomationProperties.Name="전체화면">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="1" Symbol="FullScreenMaximize24" FontSize="20"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource SidebarLabel}" Text="전체화면" />
                                <TextBlock Grid.Column="3" Style="{StaticResource SidebarHint}" Text="F11" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SidebarItemButton}" Height="44"
                                Command="{Binding AddServiceCommand}"
                                ToolTip="서비스 추가" AutomationProperties.Name="서비스 추가">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="1" Symbol="Add24" FontSize="20"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource SidebarLabel}" Text="서비스 추가" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SidebarItemButton}" Height="44"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip="설정 (Ctrl+,)" AutomationProperties.Name="설정">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="1" Symbol="Settings24" FontSize="20"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource SidebarLabel}" Text="설정" />
                                <TextBlock Grid.Column="3" Style="{StaticResource SidebarHint}" Text="Ctrl+," />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- 서비스 목록 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Services}" ItemTemplate="{StaticResource ServiceItemTemplate}"
                                      KeyboardNavigation.TabNavigation="Cycle" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 알림 배너: WebView 위에 겹치지 않고 자리를 차지한다(Airspace 회피). 평소에는 숨김. -->
                <Border Grid.Row="0" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" Padding="12,8"
                        Visibility="{Binding IsBannerOpen, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Command="{Binding CloseBannerCommand}" Appearance="Secondary"
                                   Padding="8,4" ToolTip="닫기" AutomationProperties.Name="알림 닫기">
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </ui:Button>
                        <ui:Button DockPanel.Dock="Right" Command="{Binding BannerSecondaryActionCommand}" Content="{Binding BannerSecondaryText}"
                                   Margin="0,0,8,0" Padding="12,4" Appearance="Secondary">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BannerSecondaryText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button DockPanel.Dock="Right" Command="{Binding BannerActionCommand}" Content="{Binding BannerActionText}"
                                   Margin="0,0,8,0" Padding="12,4" Appearance="Primary">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BannerActionText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding BannerTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BannerMessage}" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 서비스별 WebView2가 쌓이는 영역. ServiceHostManager가 자식을 관리한다. -->
                <Grid x:Name="HostArea" Grid.Row="1" Background="Black" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
