<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF 실행 프로젝트(04 아키텍처 2절). Generic Host로 DI와 Serilog를 구성한다. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>$(WindowsMinimumVersion)</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>MoaView.App</RootNamespace>
    <AssemblyName>MoaView</AssemblyName>
    <!-- 앱 아이콘(Assets/moaview.ico): 사이드바 타일 3개 + 재생 삼각형. 서비스 로고는 쓰지 않는다(D-08) -->
    <ApplicationIcon>Assets\moaview.ico</ApplicationIcon>
    <!-- Velopack 훅을 WPF보다 먼저 처리하려고 Program.Main을 진입점으로 쓴다(D-17) -->
    <StartupObject>MoaView.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!--
      트레이 아이콘(FR-NAV-05)은 WinForms NotifyIcon을 쓴다. UseWindowsForms=true로 켜면 WPF의 App.xaml BAML이 빠져
      시작 즉시 'app.xaml 리소스가 없습니다'로 죽으므로, 대신 WinForms 어셈블리까지 포함하는 전체 WindowsDesktop 프레임워크를 참조한다.
    -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoaView.Core\MoaView.Core.csproj" />
    <ProjectReference Include="..\MoaView.Infrastructure\MoaView.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- dotnet ef migrations의 시작 프로젝트로 쓰기 위해 필요(런타임에는 포함되지 않음) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 주입 스크립트는 포함 리소스로 싣는다(ScriptLoader) -->
    <EmbeddedResource Include="Scripts\*.js" />
    <Resource Include="Assets\moaview.ico" />
    <Resource Include="Assets\moaview.png" />
  </ItemGroup>

</Project>
